# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
# Note: Billing and pricing must be verified in the Anthropic Console
# API costs vary by model - check current pricing before use
ANTHROPIC_API_KEY=your_api_key_here

# Claude Model Configuration
# Current models as of Oct 2024: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Check https://docs.anthropic.com/en/docs/about-claude/models for latest available models
# Model names change over time - update this value if you encounter deprecation errors
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Demo Mode
# Set to 'true' to use sample campaigns without API calls (useful for testing/demo)
DEMO_MODE=false
